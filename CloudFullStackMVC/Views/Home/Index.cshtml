@{
    ViewData["Title"] = "Home";
}

<section class="hero p-4 p-md-5 mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-6">
            <h1 class="display-5"><i class="bi bi-ev-station-fill"></i> Accessible parking, reserved in seconds</h1>
            <p class="lead">
                SpotSafe helps drivers with mobility needs and EV owners find and book
                accessible and charging bays before they arrive.
            </p>
            <a class="btn btn-light btn-lg fw-semibold" asp-controller="Lots" asp-action="Index">
                <i class="bi bi-search"></i> Find a bay
            </a>
        </div>
        <div class="col-lg-6">
            <img src="~/images/hero.jpeg" alt="Parking bays with an EV charger" class="img-fluid w-100 hero-img" />
        </div>
    </div>
</section>

<div class="row text-center g-4">
    <div class="col-md-4">
        <div class="card h-100 p-4">
            <i class="bi bi-universal-access feature-icon"></i>
            <h4 class="mt-3">Accessible bays</h4>
            <p class="text-muted mb-0">Find wheelchair-accessible bays close to where you need to be.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 p-4">
            <i class="bi bi-lightning-charge-fill feature-icon"></i>
            <h4 class="mt-3">EV charging</h4>
            <p class="text-muted mb-0">See charger speeds and live availability before you drive.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 p-4">
            <i class="bi bi-calendar-check feature-icon"></i>
            <h4 class="mt-3">Book ahead</h4>
            <p class="text-muted mb-0">Reserve a time slot, get a confirmation code, and skip circling the block.</p>
        </div>
    </div>
</div>