@model List<CloudFullStackMVC.Models.Booking>
@{
    ViewData["Title"] = "My bookings";
}

<h1>My bookings</h1>

@if (TempData["Success"] != null) 
{
    <div class="alert alert-success">@TempData["Success"]</div> 
}
@if (TempData["Error"] != null)   
{
    <div class="alert alert-danger">@TempData["Error"]</div> 
}
@if (ViewBag.NeedsPassword != null)
{
    <partial name="_SetPasswordAlert" />
}
@if (ViewBag.Error != null)      
{ 
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <p>You have no bookings yet. <a asp-controller="Lots" asp-action="Index">Find a bay</a></p>
}
else
{
    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="hideCancelled" />
            <label class="form-check-label" for="hideCancelled">Hide cancelled bookings</label>
        </div>
        <input type="text" id="bookingFilter" class="form-control form-control-sm" style="max-width: 16rem;"
               placeholder="Filter by lot, bay or code" />
        <span id="bookingCount" class="text-muted small"></span>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Lot</th>
                    <th>Bay</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Code</th>
                    <th>Cost</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr class="booking-row" data-status="@b.Status">
                        <td>@b.Bay?.ParkingLot?.Name</td>
                        <td>@b.Bay?.BayCode</td>
                        <td>@b.StartUtc.ToString("ddd d MMM, h:mm tt")</td>
                        <td>@b.EndUtc.ToString("h:mm tt")</td>
                        <td><code>@b.ConfirmationCode</code></td>
                        <td>$@b.TotalCost.ToString("0.00")</td>
                        <td>@b.Status</td>
                        <td>
                            @if (b.Status == "Confirmed")
                            {
                                <form asp-action="Cancel" asp-route-id="@b.Id" method="post">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        $(function () {
            function applyFilters() {
                var hideCancelled = $('#hideCancelled').is(':checked');
                var text = $('#bookingFilter').val().toLowerCase();
                var visible = 0;

                $('.booking-row').each(function () {
                    var row = $(this);
                    var isCancelled = row.data('status') === 'Cancelled';
                    var matchesText = row.text().toLowerCase().indexOf(text) !== -1;

                    var show = matchesText && !(hideCancelled && isCancelled);
                    row.toggle(show);
                    if (show) visible++;
                });

                $('#bookingCount').text('Showing ' + visible + ' of ' + $('.booking-row').length);
            }

            // Run whenever the switch is flipped or the user types
            $('#hideCancelled').on('change', applyFilters);
            $('#bookingFilter').on('input', applyFilters);

            // Fade cancelled rows so they stand out
            $('.booking-row[data-status="Cancelled"]').addClass('text-muted').css('opacity', 0.6);

            applyFilters();
        });
    </script>
}