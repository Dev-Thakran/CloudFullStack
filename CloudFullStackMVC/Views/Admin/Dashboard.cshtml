@model List<CloudFullStackMVC.Models.ViewModels.LotReportViewModel>
@{
    ViewData["Title"] = "Admin dashboard";
}

<h1>Admin dashboard</h1>
<p class="text-muted">Bookings and revenue per parking lot (cancelled bookings excluded).</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <p>No bookings yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Lot</th>
                    <th>Bookings</th>
                    <th>Revenue</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td>@row.LotName</td>
                        <td>@row.TotalBookings</td>
                        <td>$@row.TotalRevenue.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td>Total</td>
                    <td>@Model.Sum(r => r.TotalBookings)</td>
                    <td>$@Model.Sum(r => r.TotalRevenue).ToString("0.00")</td>
                </tr>
            </tfoot>
        </table>
    </div>
}

<a asp-action="Users">Manage users</a>