@model CloudFullStackMVC.Models.Bay

<input type="hidden" asp-for="ParkingLotId" />

<div class="mb-3">
    <label asp-for="BayCode" class="form-label"></label>
    <input asp-for="BayCode" class="form-control" placeholder="e.g. A-03" />
    <span asp-validation-for="BayCode" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Type" class="form-label"></label>
    <select asp-for="Type" class="form-select">
        <option value="">-- choose --</option>
        <option value="Accessible">Accessible</option>
        <option value="EvCharging">EV charging</option>
        <option value="AccessibleEvCharging">Accessible + EV charging</option>
    </select>
    <span asp-validation-for="Type" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ChargerSpeed" class="form-label"></label>
    <select asp-for="ChargerSpeed" class="form-select">
        <option value="None">None</option>
        <option value="Standard">Standard</option>
        <option value="Fast">Fast</option>
        <option value="Rapid">Rapid</option>
    </select>
</div>

<div class="mb-3">
    <label asp-for="HourlyRate" class="form-label"></label>
    <input asp-for="HourlyRate" class="form-control" />
    <span asp-validation-for="HourlyRate" class="text-danger"></span>
</div>

<div class="form-check mb-3">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label"></label>
</div>